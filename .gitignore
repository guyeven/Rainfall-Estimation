
# macOS
.DS_Store
**/.DS_Store

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Node / Electron deps + build output
**/node_modules/
Patch-Generator/build/
Patch-Generator/dist/
Patch-Generator/electron/
Patch-Generator/electron/dist/

# Common generated report / experiment artifacts
**/Diagnostics-Out/
**/report/
**/est_dir/
**/gt_dir/
**/sol_dir_*/

# LaTeX build products
*.aux
*.log

# Stray duplicate artifacts
* 2.*
* 3.*

# Keep these refactor experiment trees visible even if they contain
# generated outputs we may want to inspect or commit intentionally.
