# benchmark_app.py
from io import BytesIO
from typing import Dict, Optional, Tuple

import h5py
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
from fastapi import Body, FastAPI, HTTPException, Query, Response
from fastapi.middleware.cors import CORSMiddleware
from scipy.ndimage import gaussian_filter
from matplotlib import cm, colors
from PIL import Image

MISSING_SENTINEL = -9e6
UPSAMPLE_FACTOR = 16  # raw-pixel -> refined-pixel factor (2km / 125m)

app = FastAPI(title="Rain Patch Smoothing (refined)")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

_BENCHMARK_PATCHES: Dict[str, dict] = {}
_LAST_DETECTION_PARAMS: Optional[dict] = None


# -------------------------
# Data IO utilities
# -------------------------
def _load_rain(path: str) -> np.ndarray:
    try:
        f = h5py.File(path, "r")
    except OSError:
        raise HTTPException(status_code=404, detail=f"HDF5 file not found: {path}")
    with f:
        data = np.array(f["/dataset1/data1/data"], dtype=np.float32)
    data[data <= MISSING_SENTINEL] = 0.0
    return data


def _get_patch_subarray(patch_id: str) -> np.ndarray:
    if patch_id not in _BENCHMARK_PATCHES:
        raise HTTPException(
            status_code=404, detail="Patch not found. Load patches first."
        )
    p = _BENCHMARK_PATCHES[patch_id]
    rain = _load_rain(p["source_file"])
    return rain[p["y_min"] : p["y_max"] + 1, p["x_min"] : p["x_max"] + 1]


# -------------------------
# Core pipeline (approved)
# -------------------------
def refine_raw_to_refinedraw(coarse: np.ndarray) -> np.ndarray:
    coarse = np.asarray(coarse, dtype=np.float32)
    R = UPSAMPLE_FACTOR
    refined = np.repeat(np.repeat(coarse, R, axis=0), R, axis=1)
    return refined


def smooth_refinedrefined(refined_raw: np.ndarray) -> np.ndarray:
    sigma = 1.0  # refined-pixel units as approved
    sm = gaussian_filter(refined_raw, sigma=sigma, mode="nearest")
    return sm


def compute_difference(smooth: np.ndarray, refined_raw: np.ndarray) -> np.ndarray:
    return smooth - refined_raw


# -------------------------
# Norms on refined grid
# -------------------------
def L1_on_refined(A: np.ndarray, B: np.ndarray) -> float:
    return float(np.abs(A - B).sum())


def Linf_on_refined(A: np.ndarray, B: np.ndarray) -> float:
    return float(np.abs(A - B).max())


def L1_per_area_on_refined(A: np.ndarray, B: np.ndarray, h_raw: int, w_raw: int) -> float:
    l1 = L1_on_refined(A, B)
    area_mm2 = (2 * h_raw) * (2 * w_raw) * 1e12  # as specified
    return float(l1 / area_mm2)


# -------------------------
# Image rendering: 1 refined-pixel -> 1 PNG pixel
# -------------------------
def _make_image(arr: np.ndarray, title: str, vmin: float, vmax: float) -> bytes:
    """
    Render arr to PNG where image pixel dims equal array dims.
    Each array element maps to exactly one image pixel (RGBA).
    """
    arr = np.asarray(arr, dtype=np.float32)
    h, w = arr.shape

    # Normalize and map to RGBA using a colormap
    norm = colors.Normalize(vmin=vmin, vmax=vmax, clip=True)
    cmap = cm.get_cmap("viridis")
    rgba = cmap(norm(arr))  # floats in [0,1], shape (h,w,4)
    rgba8 = (rgba * 255).astype(np.uint8)

    # Create PIL image (width=w, height=h) exactly
    img = Image.fromarray(rgba8, mode="RGBA")

    # Optionally add title? We avoid drawing text so pixels remain exact.
    buf = BytesIO()
    img.save(buf, format="PNG")
    return buf.getvalue()


# -------------------------
# Endpoints
# -------------------------
@app.post("/benchmark/load_patches")
def load_patches(body: dict = Body(...)):
    global _LAST_DETECTION_PARAMS
    _BENCHMARK_PATCHES.clear()

    if isinstance(body, list):
        patches = body
        detection_params = None
    else:
        patches = body.get("patches", [])
        detection_params = body.get("detection_params")

    if not isinstance(patches, list):
        raise HTTPException(status_code=400, detail="'patches' must be a list.")

    for p in patches:
        try:
            pid = str(p["id"])
            info = {
                "source_file": p["source_file"],
                "x_min": int(p["x_min"]),
                "x_max": int(p["x_max"]),
                "y_min": int(p["y_min"]),
                "y_max": int(p["y_max"]),
            }
        except KeyError as exc:
            raise HTTPException(status_code=400, detail=f"Missing key in patch: {exc!s}")
        _BENCHMARK_PATCHES[pid] = info

    _LAST_DETECTION_PARAMS = detection_params
    return {"count": len(_BENCHMARK_PATCHES), "patch_ids": sorted(_BENCHMARK_PATCHES.keys())}


@app.get("/benchmark/patch_list")
def patch_list() -> dict:
    out = []
    for pid, p in _BENCHMARK_PATCHES.items():
        out.append(
            {
                "patch_id": pid,
                "source_file": p["source_file"],
                "x_min": p["x_min"],
                "x_max": p["x_max"],
                "y_min": p["y_min"],
                "y_max": p["y_max"],
            }
        )
    return {"patches": out, "detection_params": _LAST_DETECTION_PARAMS}


@app.get("/benchmark/stats/{patch_id}")
def stats_endpoint(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    """
    Returns only DIFF stats computed on the refined grid:
      - L1, Linf, L1_per_area
    (No stats for RAW-refined or SMOOTH are returned.)
    """
    coarse = _get_patch_subarray(patch_id)
    h_raw, w_raw = coarse.shape

    refined_raw = refine_raw_to_refinedraw(coarse)
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)

    l1 = L1_on_refined(smooth, refined_raw)
    linf = Linf_on_refined(smooth, refined_raw)
    l1_area = L1_per_area_on_refined(smooth, refined_raw, h_raw, w_raw)

    return {"diff": {"l1": l1, "linf": linf, "l1_per_area": l1_area}}


@app.get("/benchmark/patch_image/{patch_id}")
def patch_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    coarse = _get_patch_subarray(patch_id)
    refined_raw = refine_raw_to_refinedraw(coarse)
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)

    vmin = float(min(refined_raw.min(), smooth.min(), diff.min()))
    vmax = float(max(refined_raw.max(), smooth.max(), diff.max()))
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5

    png = _make_image(refined_raw, "Raw (refined grid)", vmin, vmax)
    return Response(png, media_type="image/png")


@app.get("/benchmark/smooth_image/{patch_id}")
def smooth_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    coarse = _get_patch_subarray(patch_id)
    refined_raw = refine_raw_to_refinedraw(coarse)
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)

    vmin = float(min(refined_raw.min(), smooth.min(), diff.min()))
    vmax = float(max(refined_raw.max(), smooth.max(), diff.max()))
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5

    png = _make_image(smooth, "Smoothed (sigma=1 refined-px)", vmin, vmax)
    return Response(png, media_type="image/png")


@app.get("/benchmark/diff_image/{patch_id}")
def diff_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    coarse = _get_patch_subarray(patch_id)
    refined_raw = refine_raw_to_refinedraw(coarse)
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)

    vmin = float(min(refined_raw.min(), smooth.min(), diff.min()))
    vmax = float(max(refined_raw.max(), smooth.max(), diff.max()))
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5

    png = _make_image(diff, "Difference (SMOOTH - refinedRAW)", vmin, vmax)
    return Response(png, media_type="image/png")
