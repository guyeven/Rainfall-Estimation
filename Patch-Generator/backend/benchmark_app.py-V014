from io import BytesIO
from typing import Dict, Optional, Tuple

import h5py
import matplotlib

matplotlib.use("Agg")  # headless backend
import matplotlib.pyplot as plt
import numpy as np
from fastapi import Body, FastAPI, HTTPException, Query, Response
from fastapi.middleware.cors import CORSMiddleware
from scipy.ndimage import gaussian_filter, spline_filter

MISSING_SENTINEL = -9e6

# 2 km -> 125 m grid = factor 16 per dimension
UPSAMPLE_FACTOR = 16

app = FastAPI(title="Rain Patch Smoothing Benchmark")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

# patch_id -> {"source_file", "x_min", "x_max", "y_min", "y_max"}
_BENCHMARK_PATCHES: Dict[str, dict] = {}
_LAST_DETECTION_PARAMS: Optional[dict] = None


def _load_rain(path: str) -> np.ndarray:
    """Load rainfall from ODIM HDF5 and replace missing with 0."""
    try:
        f = h5py.File(path, "r")
    except OSError:
        raise HTTPException(status_code=404, detail=f"HDF5 file not found: {path}")
    with f:
        data = np.array(f["/dataset1/data1/data"], dtype=np.float32)
    data[data <= MISSING_SENTINEL] = 0.0
    return data


def _gaussian_subpixel(
    coarse: np.ndarray, sigma_raw: float
) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
    """
    Subpixel-resolved Gaussian smoothing.

    coarse: 2D coarse grid (2 km resolution).
    sigma_raw: sigma in units of coarse pixels (2 km).

    Steps:
      1. Clamp sigma_raw to [1/16, 1] coarse pixels.
      2. Upsample 16x in each direction (2 km -> 125 m).
      3. Apply Gaussian on fine grid with sigma_fine = sigma_raw * 16.
      4. Rescale to conserve total rain (mass).
      5. Return raw_fine, smooth_fine, diff_fine (all on fine grid).
    """
    coarse = np.asarray(coarse, dtype=np.float32)
    H, W = coarse.shape
    R = UPSAMPLE_FACTOR

    # 1) Clamp sigma in coarse-pixel units
    sigma_raw = float(sigma_raw)
    sigma_raw = max(1.0 / R, min(1.0, sigma_raw))  # [1/16, 1] as requested

    # 2) Upsample to fine 125 m grid by repeating each coarse pixel
    raw_fine = np.repeat(np.repeat(coarse, R, axis=0), R, axis=1)

    # 3) Gaussian in fine pixels
    sigma_fine = sigma_raw * R
    smooth_fine = gaussian_filter(raw_fine, sigma=sigma_fine, mode="nearest")

    # 4) Mass conservation: preserve total rain of coarse field
    # Coarse total ~ sum(coarse)
    # Fine total physical ~ sum(fine) / R^2 (each fine cell area = 1/R^2 coarse area units)
    sum_coarse = float(coarse.sum())
    sum_fine = float(smooth_fine.sum())

    if sum_coarse > 0.0 and sum_fine > 0.0:
        # We want physical mass match: sum_fine / R^2 == sum_coarse
        target_sum_fine = sum_coarse * (R * R)
        scale = target_sum_fine / sum_fine
        smooth_fine *= scale
    # If sum_coarse == 0 or sum_fine == 0, leave as-is (all dry or degenerate)

    # 5) Diff on fine grid
    diff_fine = raw_fine - smooth_fine

    return raw_fine.astype(np.float32), smooth_fine.astype(np.float32), diff_fine.astype(
        np.float32
    )


def _bspline_smoothing(
    coarse: np.ndarray, iterations_param: float
) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
    """
    B-spline smoothing on the coarse grid.

    iterations_param: real number, interpreted as integer iterations in [1, 20].
    """
    coarse = np.asarray(coarse, dtype=np.float32)
    iterations = int(round(iterations_param))
    iterations = max(1, min(20, iterations))

    sm = coarse
    for _ in range(iterations):
        sm = spline_filter(sm, order=3, mode="nearest")

    diff = coarse - sm
    return coarse.astype(np.float32), sm.astype(np.float32), diff.astype(np.float32)


def _get_patch_subarray(patch_id: str) -> np.ndarray:
    if patch_id not in _BENCHMARK_PATCHES:
        raise HTTPException(
            status_code=404, detail="Patch not found. Load patches first."
        )
    p = _BENCHMARK_PATCHES[patch_id]
    rain = _load_rain(p["source_file"])
    return rain[p["y_min"] : p["y_max"] + 1, p["x_min"] : p["x_max"] + 1]


def _fields_for_plots(
    patch_id: str, method: str, param: float
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, float, float]:
    """
    Compute raw, smooth, diff for plotting and vmin/vmax for a shared color scale.

    For method == "gaussian":
      - raw_plot  : coarse grid (original pixels, 2 km)
      - smooth    : fine grid (125 m)
      - diff      : fine grid (125 m)
    For method == "bspline":
      - raw_plot, smooth, diff are all on the coarse grid.

    vmin/vmax are computed over *all* arrays actually returned so that
    the three images share a consistent color scale.
    """
    coarse = _get_patch_subarray(patch_id)

    if method == "gaussian":
        raw_fine, smooth_fine, diff_fine = _gaussian_subpixel(coarse, param)
        # raw_plot remains the original coarse field
        raw_plot = coarse

        vmin = float(
            min(
                raw_plot.min(),
                smooth_fine.min(),
                diff_fine.min(),
            )
        )
        vmax = float(
            max(
                raw_plot.max(),
                smooth_fine.max(),
                diff_fine.max(),
            )
        )
        if vmin == vmax:
            vmin -= 0.5
            vmax += 0.5
        return raw_plot, smooth_fine, diff_fine, vmin, vmax

    # B-spline: everything on coarse grid
    raw_coarse, smooth_coarse, diff_coarse = _bspline_smoothing(coarse, param)
    vmin = float(
        min(
            raw_coarse.min(),
            smooth_coarse.min(),
            diff_coarse.min(),
        )
    )
    vmax = float(
        max(
            raw_coarse.max(),
            smooth_coarse.max(),
            diff_coarse.max(),
        )
    )
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5
    return raw_coarse, smooth_coarse, diff_coarse, vmin, vmax


def _fields_for_stats(
    patch_id: str, method: str, param: float
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, int]:
    """
    Compute raw, smooth, diff arrays plus the effective upsample factor for stats.

    For Gaussian:
      - raw, smooth, diff: fine grid (125 m), shape ~(H*16, W*16)
      - up_factor = 16  (to convert sums back to coarse-pixel physical units)

    For B-spline:
      - raw, smooth, diff: coarse grid
      - up_factor = 1
    """
    coarse = _get_patch_subarray(patch_id)

    if method == "gaussian":
        raw_fine, smooth_fine, diff_fine = _gaussian_subpixel(coarse, param)
        return raw_fine, smooth_fine, diff_fine, UPSAMPLE_FACTOR

    raw_coarse, smooth_coarse, diff_coarse = _bspline_smoothing(coarse, param)
    return raw_coarse, smooth_coarse, diff_coarse, 1


def _make_image(arr: np.ndarray, title: str, vmin: float, vmax: float) -> bytes:
    fig, ax = plt.subplots(figsize=(4, 4), dpi=100)
    im = ax.imshow(arr, origin="upper", vmin=vmin, vmax=vmax)
    fig.colorbar(im, ax=ax, label="mm")
    ax.set_title(title)
    ax.set_xlabel("x (pixels)")
    ax.set_ylabel("y (pixels)")
    fig.tight_layout()
    buf = BytesIO()
    fig.savefig(buf, format="png")
    plt.close(fig)
    return buf.getvalue()


def _stats(arr: np.ndarray, up_factor: int = 1) -> dict:
    """
    L¹, L∞, L¹/area over |arr|, in *coarse-pixel physical units*.

    If arr is on a fine grid (up_factor = 16), we:
      - divide the sum by up_factor^2 so that L¹ corresponds to the
        integral over coarse pixels.
      - area is counted in "equivalent coarse pixels" so L¹/area is
        comparable between methods.
    """
    a = np.abs(arr)
    # Physical L1: sum over fine grid scaled by 1 / up_factor^2
    l1 = float(a.sum()) / float(up_factor * up_factor)
    linf = float(a.max())
    # "Area" measured in coarse pixels
    area_coarse = float(arr.size) / float(up_factor * up_factor)
    l1_per_area = float(l1 / area_coarse) if area_coarse > 0 else 0.0
    return {
        "l1": l1,
        "linf": linf,
        "l1_per_area": l1_per_area,
    }


@app.post("/benchmark/load_patches")
def load_patches(body: dict = Body(...)):
    """
    Accept selected_patches.json.

    Either:
      - a bare list of patch objects, or
      - {"patches": [...], "detection_params": {...}}.
    """
    global _LAST_DETECTION_PARAMS
    _BENCHMARK_PATCHES.clear()

    # Allow both formats: plain list or {"patches": [...], ...}
    if isinstance(body, list):
        patches = body
        detection_params = None
    else:
        patches = body.get("patches", [])
        detection_params = body.get("detection_params")

    if not isinstance(patches, list):
        raise HTTPException(status_code=400, detail="'patches' must be a list.")

    for p in patches:
        try:
            # Your original JSON uses "id" for the patch identifier
            pid = str(p["id"])
            info = {
                "source_file": p["source_file"],
                "x_min": int(p["x_min"]),
                "x_max": int(p["x_max"]),
                "y_min": int(p["y_min"]),
                "y_max": int(p["y_max"]),
            }
        except KeyError as exc:
            raise HTTPException(
                status_code=400,
                detail=f"Missing key in patch: {exc!s}",
            )
        _BENCHMARK_PATCHES[pid] = info

    _LAST_DETECTION_PARAMS = detection_params
    return {
        "count": len(_BENCHMARK_PATCHES),
        "patch_ids": sorted(_BENCHMARK_PATCHES.keys()),
    }


@app.get("/benchmark/patch_list")
def patch_list() -> dict:
    """Return list of available patch_ids and their bounds."""
    out = []
    for pid, p in _BENCHMARK_PATCHES.items():
        out.append(
            {
                "patch_id": pid,
                "source_file": p["source_file"],
                "x_min": p["x_min"],
                "x_max": p["x_max"],
                "y_min": p["y_min"],
                "y_max": p["y_max"],
            }
        )
    return {"patches": out, "detection_params": _LAST_DETECTION_PARAMS}


@app.get("/benchmark/stats/{patch_id}")
def stats_endpoint(
    patch_id: str,
    method: str = Query("gaussian"),
    # For Gaussian: interpreted as sigma_raw in coarse pixels, clamped to [1/16, 1].
    # For B-spline: interpreted as iteration count, rounded and clamped [1, 20].
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    raw, smooth, diff, up = _fields_for_stats(patch_id, method, max_components)
    return {
        "raw": _stats(raw, up),
        "smooth": _stats(smooth, up),
        "diff": _stats(diff, up),
    }


@app.get("/benchmark/patch_image/{patch_id}")
def patch_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    # Raw patch is always shown on the coarse 2 km grid
    coarse = _get_patch_subarray(patch_id)

    # To keep color scales consistent with smoothed/diff images,
    # we reuse vmin/vmax from the smoothing logic but ignore its raw field.
    _, smooth, diff, vmin, vmax = _fields_for_plots(
        patch_id, method, max_components
    )
    png = _make_image(coarse, "Raw", vmin, vmax)
    return Response(png, media_type="image/png")


@app.get("/benchmark/smooth_image/{patch_id}")
def smooth_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    raw_plot, smooth, diff, vmin, vmax = _fields_for_plots(
        patch_id, method, max_components
    )
    png = _make_image(smooth, f"Smoothed ({method})", vmin, vmax)
    return Response(png, media_type="image/png")


@app.get("/benchmark/diff_image/{patch_id}")
def diff_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    raw_plot, smooth, diff, vmin, vmax = _fields_for_plots(
        patch_id, method, max_components
    )
    png = _make_image(diff, "Difference", vmin, vmax)
    return Response(png, media_type="image/png")
