# benchmark_app.py
from io import BytesIO
from typing import Dict, Optional, Tuple

import h5py
import matplotlib

matplotlib.use("Agg")  # headless
import matplotlib.pyplot as plt
import numpy as np
from fastapi import Body, FastAPI, HTTPException, Query, Response
from fastapi.middleware.cors import CORSMiddleware
from scipy.ndimage import gaussian_filter

MISSING_SENTINEL = -9e6
UPSAMPLE_FACTOR = 16  # raw-pixel -> refined-pixel factor (2km / 125m)

app = FastAPI(title="Rain Patch Smoothing (refined)")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

# patch_id -> {"source_file", "x_min", "x_max", "y_min", "y_max"}
_BENCHMARK_PATCHES: Dict[str, dict] = {}
_LAST_DETECTION_PARAMS: Optional[dict] = None


# -------------------------
# Data IO utilities
# -------------------------
def _load_rain(path: str) -> np.ndarray:
    """Load rainfall from ODIM HDF5 and replace missing with 0 (mm)."""
    try:
        f = h5py.File(path, "r")
    except OSError:
        raise HTTPException(status_code=404, detail=f"HDF5 file not found: {path}")
    with f:
        data = np.array(f["/dataset1/data1/data"], dtype=np.float32)
    data[data <= MISSING_SENTINEL] = 0.0
    return data


def _get_patch_subarray(patch_id: str) -> np.ndarray:
    """Return the coarse patch (h x w) in raw-pixel units (2 km resolution)."""
    if patch_id not in _BENCHMARK_PATCHES:
        raise HTTPException(status_code=404, detail="Patch not found. Load patches first.")
    p = _BENCHMARK_PATCHES[patch_id]
    rain = _load_rain(p["source_file"])
    # inclusive bounds assumed in stored patch info
    return rain[p["y_min"] : p["y_max"] + 1, p["x_min"] : p["x_max"] + 1]


# -------------------------
# Core pipeline (exactly as you approved)
# -------------------------
def refine_raw_to_refinedraw(coarse: np.ndarray) -> np.ndarray:
    """
    Build refinedRAW by copying each raw-pixel (coarse[i,j]) to a 16x16 block.
    Output shape = (16*h, 16*w).
    Values remain in mm (same units as coarse).
    """
    coarse = np.asarray(coarse, dtype=np.float32)
    R = UPSAMPLE_FACTOR
    refined = np.repeat(np.repeat(coarse, R, axis=0), R, axis=1)
    return refined


def smooth_refinedrefined(refined_raw: np.ndarray) -> np.ndarray:
    """
    SMOOTH = gaussian_filter(refinedRAW, sigma=1.0) with sigma in refined-pixel units.
    Exactly sigma = 1.0, no user-controlled sigma here (per approved plan).
    """
    # sigma = 1 refined-pixel unit exactly
    sigma = 1.0
    # mode='nearest' to avoid introducing external values
    sm = gaussian_filter(refined_raw, sigma=sigma, mode="nearest")
    return sm


def compute_difference(smooth: np.ndarray, refined_raw: np.ndarray) -> np.ndarray:
    """DIFFERENCE = SMOOTH - refinedRAW (elementwise), refined grid."""
    return smooth - refined_raw


# -------------------------
# Norms on refined grid (exact definitions)
# -------------------------
def L1_on_refined(A: np.ndarray, B: np.ndarray) -> float:
    """Sum over refined pixels of |A - B|. Units: mm * (number of refined pixels)."""
    return float(np.abs(A - B).sum())


def Linf_on_refined(A: np.ndarray, B: np.ndarray) -> float:
    """Max over refined pixels of |A - B|. Units: mm."""
    return float(np.abs(A - B).max())


def L1_per_area_on_refined(A: np.ndarray, B: np.ndarray, h_raw: int, w_raw: int) -> float:
    """
    L1(A,B) / area, where area = (2*h_raw x 2*w_raw) * 1e12 mm^2, as requested.

    - A,B are refined arrays of shape (16*h_raw, 16*w_raw).
    - Denominator equals 4 * h_raw * w_raw * 1e12 (mm^2).
    """
    l1 = L1_on_refined(A, B)  # mm * refined_pixels
    # physical area in mm^2:
    area_mm2 = (2 * h_raw) * (2 * w_raw) * 1e12  # (km * km -> mm^2) per your formula
    # result units: mm / mm^2 = 1/mm; keep as float
    return float(l1 / area_mm2)


# -------------------------
# Image rendering: map refined-pixel -> PNG pixel 1:1
# -------------------------
def _make_image(arr: np.ndarray, title: str, vmin: float, vmax: float) -> bytes:
    """
    Render arr to PNG so that each array element maps to roughly one PNG pixel.

    - Sets fig size = (w/dpi, h/dpi) with dpi = 100 so PNG size ~ (w,h) pixels.
    - Uses interpolation='nearest' to avoid Matplotlib resampling.
    """
    arr = np.asarray(arr)
    h, w = arr.shape
    dpi = 100
    figsize = (max(1.0, w / dpi), max(1.0, h / dpi))
    fig, ax = plt.subplots(figsize=figsize, dpi=dpi)
    im = ax.imshow(arr, origin="upper", vmin=vmin, vmax=vmax, interpolation="nearest")
    fig.colorbar(im, ax=ax, label="mm")
    ax.set_title(title)
    ax.set_xlabel("x (pixels)")
    ax.set_ylabel("y (pixels)")
    fig.tight_layout(pad=0.2)
    buf = BytesIO()
    fig.savefig(buf, format="png", dpi=dpi, bbox_inches="tight", pad_inches=0)
    plt.close(fig)
    return buf.getvalue()


# -------------------------
# Endpoints
# -------------------------
@app.post("/benchmark/load_patches")
def load_patches(body: dict = Body(...)):
    """
    Accept selection JSON: either a list of patches, or {"patches": [...], "detection_params": {...}}.
    Patch objects must contain keys: id, source_file, x_min, x_max, y_min, y_max
    """
    global _LAST_DETECTION_PARAMS
    _BENCHMARK_PATCHES.clear()

    if isinstance(body, list):
        patches = body
        detection_params = None
    else:
        patches = body.get("patches", [])
        detection_params = body.get("detection_params")

    if not isinstance(patches, list):
        raise HTTPException(status_code=400, detail="'patches' must be a list.")

    for p in patches:
        try:
            pid = str(p["id"])
            info = {
                "source_file": p["source_file"],
                "x_min": int(p["x_min"]),
                "x_max": int(p["x_max"]),
                "y_min": int(p["y_min"]),
                "y_max": int(p["y_max"]),
            }
        except KeyError as exc:
            raise HTTPException(status_code=400, detail=f"Missing key in patch: {exc!s}")
        _BENCHMARK_PATCHES[pid] = info

    _LAST_DETECTION_PARAMS = detection_params
    return {"count": len(_BENCHMARK_PATCHES), "patch_ids": sorted(_BENCHMARK_PATCHES.keys())}


@app.get("/benchmark/patch_list")
def patch_list() -> dict:
    out = []
    for pid, p in _BENCHMARK_PATCHES.items():
        out.append(
            {
                "patch_id": pid,
                "source_file": p["source_file"],
                "x_min": p["x_min"],
                "x_max": p["x_max"],
                "y_min": p["y_min"],
                "y_max": p["y_max"],
            }
        )
    return {"patches": out, "detection_params": _LAST_DETECTION_PARAMS}


@app.get("/benchmark/stats/{patch_id}")
def stats_endpoint(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    """
    Note: for this approved flow:
      - we always refine RAW to refinedRAW,
      - we always apply gaussian sigma=1 (refined-pixel unit),
      - max_components is accepted for compatibility but ignored for Gaussian smoothing here.
    """
    coarse = _get_patch_subarray(patch_id)
    h_raw, w_raw = coarse.shape

    # 1) refinedRAW
    refined_raw = refine_raw_to_refinedraw(coarse)

    # 2) SMOOTH with sigma=1 in refined pixels
    smooth = smooth_refinedrefined(refined_raw)

    # 3) DIFF = SMOOTH - refinedRAW
    diff = compute_difference(smooth, refined_raw)

    # norms on refined grid
    l1 = L1_on_refined(smooth, refined_raw)
    linf = Linf_on_refined(smooth, refined_raw)
    l1_area = L1_per_area_on_refined(smooth, refined_raw, h_raw, w_raw)

    return {
        "raw_shape_refined": refined_raw.shape,
        "smooth_shape_refined": smooth.shape,
        "diff_shape_refined": diff.shape,
        "raw": {"sum_mm": float(refined_raw.sum())},
        "smooth": {"sum_mm": float(smooth.sum())},
        "diff": {"l1": l1, "linf": linf, "l1_per_area": l1_area},
    }


@app.get("/benchmark/patch_image/{patch_id}")
def patch_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    """
    Return PNG of refinedRAW (the refined raw map). This makes raw/smooth/diff
    comparable because they all share the refined grid.
    """
    coarse = _get_patch_subarray(patch_id)
    refined_raw = refine_raw_to_refinedraw(coarse)

    # For consistent color scale, compute smoothed/diff too
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)
    vmin = float(min(refined_raw.min(), smooth.min(), diff.min()))
    vmax = float(max(refined_raw.max(), smooth.max(), diff.max()))
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5

    png = _make_image(refined_raw, "Raw (refined grid)", vmin, vmax)
    return Response(png, media_type="image/png")


@app.get("/benchmark/smooth_image/{patch_id}")
def smooth_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    coarse = _get_patch_subarray(patch_id)
    refined_raw = refine_raw_to_refinedraw(coarse)
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)
    vmin = float(min(refined_raw.min(), smooth.min(), diff.min()))
    vmax = float(max(refined_raw.max(), smooth.max(), diff.max()))
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5
    png = _make_image(smooth, "Smoothed (gaussian, sigma=1 refined-px)", vmin, vmax)
    return Response(png, media_type="image/png")


@app.get("/benchmark/diff_image/{patch_id}")
def diff_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    coarse = _get_patch_subarray(patch_id)
    refined_raw = refine_raw_to_refinedraw(coarse)
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)
    vmin = float(min(refined_raw.min(), smooth.min(), diff.min()))
    vmax = float(max(refined_raw.max(), smooth.max(), diff.max()))
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5
    png = _make_image(diff, "Difference (SMOOTH - refinedRAW)", vmin, vmax)
    return Response(png, media_type="image/png")
