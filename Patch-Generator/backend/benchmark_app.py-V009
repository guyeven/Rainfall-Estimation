from io import BytesIO
from typing import Dict, List, Optional, Tuple

import h5py
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
from fastapi import Body, FastAPI, HTTPException, Query, Response
from fastapi.middleware.cors import CORSMiddleware
from scipy.ndimage import gaussian_filter, spline_filter

MISSING_SENTINEL = -9e6

app = FastAPI(title="Rain Patch Smoothing Benchmark")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

# patch_id -> {"source_file", "x_min", "x_max", "y_min", "y_max"}
_BENCHMARK_PATCHES: Dict[str, dict] = {}
_LAST_DETECTION_PARAMS: Optional[dict] = None


def _load_rain(path: str) -> np.ndarray:
    """Load rainfall from ODIM HDF5 and replace missing with 0."""
    try:
        f = h5py.File(path, "r")
    except OSError:
        raise HTTPException(status_code=404, detail=f"HDF5 file not found: {path}")
    with f:
        data = np.array(f["/dataset1/data1/data"], dtype=np.float32)
    data[data <= MISSING_SENTINEL] = 0.0
    return data


def _smooth_patch(arr: np.ndarray, method: str, max_components: int) -> np.ndarray:
    """Smooth array using Gaussian or repeated B-spline."""
    max_components = max(1, int(max_components))
    h, w = arr.shape
    if method == "gaussian":
        sigma = max(0.5, max(h, w) / (8.0 * max_components))
        return gaussian_filter(arr, sigma=sigma, mode="nearest")
    if method == "bspline":
        sm = arr.astype(np.float32)
        for _ in range(max_components):
            sm = spline_filter(sm, order=3, mode="nearest")
        return sm
    raise HTTPException(status_code=400, detail=f"Unknown method: {method}")


def _get_patch_subarray(patch_id: str) -> np.ndarray:
    if patch_id not in _BENCHMARK_PATCHES:
        raise HTTPException(status_code=404, detail="Patch not found. Load patches first.")
    p = _BENCHMARK_PATCHES[patch_id]
    rain = _load_rain(p["source_file"])
    return rain[p["y_min"] : p["y_max"] + 1, p["x_min"] : p["x_max"] + 1]


def _raw_smooth_diff_with_scale(
    patch_id: str, method: str, max_components: int
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, float, float]:
    """Compute raw, smooth, diff and shared vmin/vmax for plotting."""
    sub = _get_patch_subarray(patch_id)
    smooth = _smooth_patch(sub, method, max_components)
    diff = sub - smooth
    vmin = float(min(sub.min(), smooth.min(), diff.min()))
    vmax = float(max(sub.max(), smooth.max(), diff.max()))
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5
    return sub, smooth, diff, vmin, vmax


def _make_image(arr: np.ndarray, title: str, vmin: float, vmax: float) -> bytes:
    fig, ax = plt.subplots(figsize=(4, 4), dpi=100)
    im = ax.imshow(arr, origin="upper", vmin=vmin, vmax=vmax)
    fig.colorbar(im, ax=ax, label="mm")
    ax.set_title(title)
    ax.set_xlabel("x (pixels)")
    ax.set_ylabel("y (pixels)")
    fig.tight_layout()
    buf = BytesIO()
    fig.savefig(buf, format="png")
    plt.close(fig)
    return buf.getvalue()


def _stats(arr: np.ndarray) -> dict:
    """L¹, L∞, L¹/area over |arr|."""
    a = np.abs(arr)
    l1 = float(a.sum())
    linf = float(a.max())
    area = int(arr.size)
    return {
      "l1": l1,
      "linf": linf,
      "l1_per_area": float(l1 / area) if area > 0 else 0.0,
    }


@app.post("/benchmark/load_patches")
def load_patches(body: dict = Body(...)):
    """
    Accept selected_patches.json.

    Either:
      - a bare list of patch objects, or
      - {"patches": [...], "detection_params": {...}}.
    """
    global _LAST_DETECTION_PARAMS
    _BENCHMARK_PATCHES.clear()

    if isinstance(body, list):
        patches = body
        detection_params = None
    else:
        patches = body.get("patches", [])
        detection_params = body.get("detection_params")

    if not isinstance(patches, list):
        raise HTTPException(status_code=400, detail="'patches' must be a list.")

    for p in patches:
        try:
            pid = p["id"]
            info = {
                "source_file": p["source_file"],
                "x_min": int(p["x_min"]),
                "x_max": int(p["x_max"]),
                "y_min": int(p["y_min"]),
                "y_max": int(p["y_max"]),
            }
        except KeyError as exc:
            raise HTTPException(status_code=400, detail=f"Missing key in patch: {exc!s}")
        _BENCHMARK_PATCHES[pid] = info

    _LAST_DETECTION_PARAMS = detection_params
    return {"count": len(_BENCHMARK_PATCHES), "patch_ids": sorted(_BENCHMARK_PATCHES.keys())}


@app.get("/benchmark/patch_ids")
def patch_ids() -> List[str]:
    return sorted(_BENCHMARK_PATCHES.keys())


@app.get("/benchmark/detection_params")
def detection_params():
    return _LAST_DETECTION_PARAMS or {}


@app.get("/benchmark/stats/{patch_id}")
def stats_endpoint(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: int = Query(3, ge=1, le=20),
):
    sub, smooth, diff, _, _ = _raw_smooth_diff_with_scale(
        patch_id, method, max_components
    )
    return {
        "raw": _stats(sub),
        "smooth": _stats(smooth),
        "diff": _stats(diff),
    }


@app.get("/benchmark/patch_image/{patch_id}")
def patch_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: int = Query(3, ge=1, le=20),
):
    sub, smooth, diff, vmin, vmax = _raw_smooth_diff_with_scale(
        patch_id, method, max_components
    )
    png = _make_image(sub, "Raw", vmin, vmax)
    return Response(png, media_type="image/png")


@app.get("/benchmark/smooth_image/{patch_id}")
def smooth_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: int = Query(3, ge=1, le=20),
):
    sub, smooth, diff, vmin, vmax = _raw_smooth_diff_with_scale(
        patch_id, method, max_components
    )
    png = _make_image(smooth, f"Smoothed ({method})", vmin, vmax)
    return Response(png, media_type="image/png")


@app.get("/benchmark/diff_image/{patch_id}")
def diff_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: int = Query(3, ge=1, le=20),
):
    sub, smooth, diff, vmin, vmax = _raw_smooth_diff_with_scale(
        patch_id, method, max_components
    )
    png = _make_image(diff, "Difference", vmin, vmax)
    return Response(png, media_type="image/png")
