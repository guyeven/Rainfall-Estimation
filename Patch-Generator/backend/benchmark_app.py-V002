from __future__ import annotations

from dataclasses import dataclass
from io import BytesIO
from typing import Dict, List, Literal, Optional

import h5py
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
from fastapi import FastAPI, HTTPException, Query, Response
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from scipy.ndimage import gaussian_filter, spline_filter


class SmoothMethod:
    GAUSSIAN = "gaussian"
    BSPLINE = "bspline"


class PatchIn(BaseModel):
    """Minimal shape of a patch from selected_patches.json.

    Extra keys (area_km2, max_rainfall, etc.) are ignored.
    """

    id: str
    source_file: str
    x_min: int
    x_max: int
    y_min: int
    y_max: int

    class Config:
        extra = "ignore"  # accept additional keys without failing


class LoadRequest(BaseModel):
    detection_params: Optional[dict] = None
    patches: List[PatchIn]


@dataclass
class BenchmarkPatch:
    id: str
    source_file: str
    x_min: int
    x_max: int
    y_min: int
    y_max: int


app = FastAPI(title="Rain Patch Smoothing Benchmark")
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

_BENCHMARK_PATCHES: Dict[str, BenchmarkPatch] = {}
_LAST_DETECTION_PARAMS: Optional[dict] = None


def _load_rain(path: str) -> np.ndarray:
    """Load rainfall from ODIM HDF5; replace missing (<= -9e6) with 0."""
    try:
        f = h5py.File(path, "r")
    except OSError:
        raise HTTPException(status_code=404, detail=f"HDF5 file not found: {path}")
    with f:
        data = np.array(f["/dataset1/data1/data"], dtype=np.float32)
    data[data <= -9e6] = 0.0
    return data


def _smooth_patch(arr: np.ndarray, method: str, max_components: int) -> np.ndarray:
    """Simple smooth approximation: Gaussian or repeated B-spline."""
    max_components = max(1, int(max_components))
    h, w = arr.shape
    if method == SmoothMethod.GAUSSIAN:
        # larger patches + fewer components → stronger smoothing
        sigma = max(0.5, max(h, w) / (8.0 * max_components))
        return gaussian_filter(arr, sigma=sigma, mode="nearest")
    if method == SmoothMethod.BSPLINE:
        sm = arr.astype(np.float32)
        for _ in range(max_components):
            sm = spline_filter(sm, order=3, mode="nearest")
        return sm
    raise HTTPException(status_code=400, detail=f"Unknown method: {method}")


def _make_image(arr: np.ndarray, title: str) -> bytes:
    """Render a rainfall patch as PNG."""
    fig, ax = plt.subplots(figsize=(4, 4), dpi=100)
    im = ax.imshow(arr, origin="upper")
    fig.colorbar(im, ax=ax, label="mm")
    ax.set_title(title)
    ax.set_xlabel("x (pixels)")
    ax.set_ylabel("y (pixels)")
    fig.tight_layout()
    buf = BytesIO()
    fig.savefig(buf, format="png")
    plt.close(fig)
    return buf.getvalue()


def _get_patch_subarray(patch_id: str) -> np.ndarray:
    """Fetch cropped rainfall array for a given patch id."""
    if patch_id not in _BENCHMARK_PATCHES:
        raise HTTPException(
            status_code=404, detail="Patch not found. Load patches first."
        )
    p = _BENCHMARK_PATCHES[patch_id]
    rain = _load_rain(p.source_file)
    return rain[p.y_min : p.y_max + 1, p.x_min : p.x_max + 1]


@app.post("/benchmark/load_patches")
def load_patches(req: LoadRequest):
    """Load patches into memory from selected_patches.json content."""
    global _LAST_DETECTION_PARAMS
    _BENCHMARK_PATCHES.clear()
    for p in req.patches:
        _BENCHMARK_PATCHES[p.id] = BenchmarkPatch(
            id=p.id,
            source_file=p.source_file,
            x_min=p.x_min,
            x_max=p.x_max,
            y_min=p.y_min,
            y_max=p.y_max,
        )
    _LAST_DETECTION_PARAMS = req.detection_params
    return {
        "count": len(_BENCHMARK_PATCHES),
        "patch_ids": sorted(_BENCHMARK_PATCHES.keys()),
    }


@app.get("/benchmark/patch_ids")
def list_patch_ids() -> List[str]:
    return sorted(_BENCHMARK_PATCHES.keys())


@app.get("/benchmark/detection_params")
def get_detection_params():
    return _LAST_DETECTION_PARAMS or {}


@app.get("/benchmark/patch_image/{patch_id}")
def patch_image(patch_id: str):
    sub = _get_patch_subarray(patch_id)
    png = _make_image(sub, f"{patch_id} – raw")
    return Response(png, media_type="image/png")


@app.get("/benchmark/smooth_image/{patch_id}")
def smooth_image(
    patch_id: str,
    method: str = Query("gaussian", enum=["gaussian", "bspline"]),
    max_components: int = Query(3, ge=1, le=20),
):
    sub = _get_patch_subarray(patch_id)
    smooth = _smooth_patch(sub, method, max_components)
    png = _make_image(smooth, f"{patch_id} – {method}")
    return Response(png, media_type="image/png")


@app.get("/benchmark/diff_image/{patch_id}")
def diff_image(
    patch_id: str,
    method: str = Query("gaussian", enum=["gaussian", "bspline"]),
    max_components: int = Query(3, ge=1, le=20),
):
    sub = _get_patch_subarray(patch_id)
    smooth = _smooth_patch(sub, method, max_components)
    diff = sub - smooth
    png = _make_image(diff, f"{patch_id} – diff")
    return Response(png, media_type="image/png")


if __name__ == "__main__":
    import uvicorn

    uvicorn.run("benchmark_app:app", host="0.0.0.0", port=8201, reload=True)
