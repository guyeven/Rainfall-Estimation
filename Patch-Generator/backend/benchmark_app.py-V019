# benchmark_app.py
from io import BytesIO
from typing import Dict, Optional, Tuple

import h5py
import numpy as np
from fastapi import Body, FastAPI, HTTPException, Query, Response
from fastapi.middleware.cors import CORSMiddleware
from scipy.ndimage import gaussian_filter
from matplotlib import cm, colors
from PIL import Image, ImageDraw, ImageFont

MISSING_SENTINEL = -9e6
UPSAMPLE_FACTOR = 16  # raw-pixel -> refined-pixel factor (2km / 125m)

app = FastAPI(title="Rain Patch Smoothing (refined)")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

_BENCHMARK_PATCHES: Dict[str, dict] = {}
_LAST_DETECTION_PARAMS: Optional[dict] = None

# -------------------------
# Data IO utilities
# -------------------------
def _load_rain(path: str) -> np.ndarray:
    try:
        f = h5py.File(path, "r")
    except OSError:
        raise HTTPException(status_code=404, detail=f"HDF5 file not found: {path}")
    with f:
        data = np.array(f["/dataset1/data1/data"], dtype=np.float32)
    data[data <= MISSING_SENTINEL] = 0.0
    return data


def _get_patch_subarray(patch_id: str) -> np.ndarray:
    if patch_id not in _BENCHMARK_PATCHES:
        raise HTTPException(status_code=404, detail="Patch not found. Load patches first.")
    p = _BENCHMARK_PATCHES[patch_id]
    rain = _load_rain(p["source_file"])
    return rain[p["y_min"] : p["y_max"] + 1, p["x_min"] : p["x_max"] + 1]


# -------------------------
# Core pipeline (approved)
# -------------------------
def refine_raw_to_refinedraw(coarse: np.ndarray) -> np.ndarray:
    coarse = np.asarray(coarse, dtype=np.float32)
    R = UPSAMPLE_FACTOR
    refined = np.repeat(np.repeat(coarse, R, axis=0), R, axis=1)
    return refined


def smooth_refinedrefined(refined_raw: np.ndarray) -> np.ndarray:
    sigma = 1.0  # refined-pixel units exactly
    sm = gaussian_filter(refined_raw, sigma=sigma, mode="nearest")
    return sm


def compute_difference(smooth: np.ndarray, refined_raw: np.ndarray) -> np.ndarray:
    return smooth - refined_raw


# -------------------------
# Norms on refined grid
# -------------------------
def L1_on_refined(A: np.ndarray, B: np.ndarray) -> float:
    return float(np.abs(A - B).sum())


def Linf_on_refined(A: np.ndarray, B: np.ndarray) -> float:
    return float(np.abs(A - B).max())


def L1_per_area_on_refined(A: np.ndarray, B: np.ndarray, h_raw: int, w_raw: int) -> float:
    l1 = L1_on_refined(A, B)
    area_mm2 = (2 * h_raw) * (2 * w_raw) * 1e12  # as specified by you
    return float(l1 / area_mm2)


# -------------------------
# Image rendering: 1 refined-pixel -> 1 PNG pixel, plus overlaid labels
# -------------------------
def _make_image_with_labels(
    arr: np.ndarray,
    title: str,
    vmin: float,
    vmax: float,
    xlabel: str = "x (refined-px)",
    ylabel: str = "y (refined-px)",
) -> bytes:
    """
    Render arr to PNG where image dims equal array dims (w x h).
    Draw title and axis labels overlaid on the image (so dims stay identical).
    """
    arr = np.asarray(arr, dtype=np.float32)
    h, w = arr.shape

    # Map values to RGBA via colormap
    norm = colors.Normalize(vmin=vmin, vmax=vmax, clip=True)
    cmap = cm.get_cmap("viridis")
    rgba = cmap(norm(arr))  # shape (h,w,4), floats 0..1
    rgba8 = (rgba * 255).astype(np.uint8)

    img = Image.fromarray(rgba8, mode="RGBA")  # width=w, height=h

    draw = ImageDraw.Draw(img)

    # Choose a reasonable font size relative to image size
    # Use default PIL font if truetype unavailable
    try:
        # This will use a default TTF if available on system; fallback to default.
        font_title = ImageFont.truetype("DejaVuSans-Bold.ttf", max(10, w // 40))
        font_axis = ImageFont.truetype("DejaVuSans.ttf", max(8, w // 60))
    except Exception:
        font_title = ImageFont.load_default()
        font_axis = ImageFont.load_default()

    # Draw a semi-transparent rectangle behind text for readability
    # Title at top center
    title_text = title
    tw, th = draw.textsize(title_text, font=font_title)
    # position for title: centered horizontally, small margin from top
    tx = max(2, (w - tw) // 2)
    ty = 2
    rect_pad = 4
    draw.rectangle([tx - rect_pad, ty - rect_pad, tx + tw + rect_pad, ty + th + rect_pad], fill=(0, 0, 0, 120))
    draw.text((tx, ty), title_text, fill=(255, 255, 255, 255), font=font_title)

    # X label bottom center (overlay)
    xl_text = xlabel
    xl_w, xl_h = draw.textsize(xl_text, font=font_axis)
    xl_x = max(2, (w - xl_w) // 2)
    xl_y = max(2, h - xl_h - 4)
    draw.rectangle([xl_x - rect_pad, xl_y - rect_pad, xl_x + xl_w + rect_pad, xl_y + xl_h + rect_pad], fill=(0, 0, 0, 120))
    draw.text((xl_x, xl_y), xl_text, fill=(255, 255, 255, 255), font=font_axis)

    # Y label at left, rotated vertically
    yl_text = ylabel
    yl_w, yl_h = draw.textsize(yl_text, font=font_axis)
    # Create a small image for rotated text
    yimg = Image.new("RGBA", (yl_h, yl_w), (0, 0, 0, 0))
    ydraw = ImageDraw.Draw(yimg)
    # rectangle background
    ydraw.rectangle([0, 0, yl_h, yl_w], fill=(0, 0, 0, 120))
    ydraw.text((0, 0), yl_text, fill=(255, 255, 255, 255), font=font_axis)
    yimg = yimg.rotate(90, expand=True)
    # paste at left center with small margin
    ypx = 2
    ypy = max(2, (h - yimg.size[1]) // 2)
    img.paste(yimg, (ypx, ypy), yimg)

    # Save PNG bytes exactly w x h
    buf = BytesIO()
    img.save(buf, format="PNG")
    return buf.getvalue()


# -------------------------
# Endpoints
# -------------------------
@app.post("/benchmark/load_patches")
def load_patches(body: dict = Body(...)):
    global _LAST_DETECTION_PARAMS
    _BENCHMARK_PATCHES.clear()

    if isinstance(body, list):
        patches = body
        detection_params = None
    else:
        patches = body.get("patches", [])
        detection_params = body.get("detection_params")

    if not isinstance(patches, list):
        raise HTTPException(status_code=400, detail="'patches' must be a list.")

    for p in patches:
        try:
            pid = str(p["id"])
            info = {
                "source_file": p["source_file"],
                "x_min": int(p["x_min"]),
                "x_max": int(p["x_max"]),
                "y_min": int(p["y_min"]),
                "y_max": int(p["y_max"]),
            }
        except KeyError as exc:
            raise HTTPException(status_code=400, detail=f"Missing key in patch: {exc!s}")
        _BENCHMARK_PATCHES[pid] = info

    _LAST_DETECTION_PARAMS = detection_params
    return {"count": len(_BENCHMARK_PATCHES), "patch_ids": sorted(_BENCHMARK_PATCHES.keys())}


@app.get("/benchmark/patch_list")
def patch_list() -> dict:
    out = []
    for pid, p in _BENCHMARK_PATCHES.items():
        out.append(
            {
                "patch_id": pid,
                "source_file": p["source_file"],
                "x_min": p["x_min"],
                "x_max": p["x_max"],
                "y_min": p["y_min"],
                "y_max": p["y_max"],
            }
        )
    return {"patches": out, "detection_params": _LAST_DETECTION_PARAMS}


@app.get("/benchmark/stats/{patch_id}")
def stats_endpoint(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    """
    Returns stats computed on the refined grid for RAW, SMOOTH and DIFF.
    - raw/smooth sums are provided (sum of mm over refined pixels).
    - diff: L1, Linf, L1_per_area computed exactly as specified.
    """
    coarse = _get_patch_subarray(patch_id)
    h_raw, w_raw = coarse.shape

    refined_raw = refine_raw_to_refinedraw(coarse)
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)

    # Raw and smooth sums (on refined grid)
    sum_raw = float(refined_raw.sum())
    sum_smooth = float(smooth.sum())

    l1 = L1_on_refined(smooth, refined_raw)
    linf = Linf_on_refined(smooth, refined_raw)
    l1_area = L1_per_area_on_refined(smooth, refined_raw, h_raw, w_raw)

    return {
        "raw": {"shape_refined": refined_raw.shape, "sum_mm": sum_raw},
        "smooth": {"shape_refined": smooth.shape, "sum_mm": sum_smooth},
        "diff": {"shape_refined": diff.shape, "l1": l1, "linf": linf, "l1_per_area": l1_area},
    }


@app.get("/benchmark/patch_image/{patch_id}")
def patch_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    coarse = _get_patch_subarray(patch_id)
    refined_raw = refine_raw_to_refinedraw(coarse)
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)

    vmin = float(min(refined_raw.min(), smooth.min(), diff.min()))
    vmax = float(max(refined_raw.max(), smooth.max(), diff.max()))
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5

    png = _make_image_with_labels(refined_raw, "Raw (refined grid)", vmin, vmax)
    return Response(png, media_type="image/png")


@app.get("/benchmark/smooth_image/{patch_id}")
def smooth_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    coarse = _get_patch_subarray(patch_id)
    refined_raw = refine_raw_to_refinedraw(coarse)
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)

    vmin = float(min(refined_raw.min(), smooth.min(), diff.min()))
    vmax = float(max(refined_raw.max(), smooth.max(), diff.max()))
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5

    png = _make_image_with_labels(smooth, "Smoothed (sigma=1 refined-px)", vmin, vmax)
    return Response(png, media_type="image/png")


@app.get("/benchmark/diff_image/{patch_id}")
def diff_image(
    patch_id: str,
    method: str = Query("gaussian"),
    max_components: float = Query(1.0 / 16.0, ge=1.0 / 16.0, le=20.0),
):
    coarse = _get_patch_subarray(patch_id)
    refined_raw = refine_raw_to_refinedraw(coarse)
    smooth = smooth_refinedrefined(refined_raw)
    diff = compute_difference(smooth, refined_raw)

    vmin = float(min(refined_raw.min(), smooth.min(), diff.min()))
    vmax = float(max(refined_raw.max(), smooth.max(), diff.max()))
    if vmin == vmax:
        vmin -= 0.5
        vmax += 0.5

    png = _make_image_with_labels(diff, "Difference (SMOOTH - refinedRAW)", vmin, vmax)
    return Response(png, media_type="image/png")
